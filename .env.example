# Get a key at https://reactor.inc (starts with rk_)
REACTOR_API_KEY=

# Optional: the wall of shared takes. Added for you when Upstash for Redis is connected in Vercel Storage.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional: a secret that lets you remove wall posts with DELETE /api/wall?id=...&key=...
WALL_ADMIN_KEY=

# Optional: automatic one line photo descriptions. Either key works.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
